MYSQL_ROOT_PASSWORD=troque_essa_senha
DB_USERNAME=imovcg
DB_PASSWORD=troque_essa_senha

CORS_ALLOWED_ORIGINS=*

# Login do anunciante (Google Identity Services).
# O Client ID e publico; o segredo de assinatura do nosso JWT, nao.
GOOGLE_CLIENT_ID=
# Gere com: openssl rand -base64 48
JWT_SECRET=troque_esse_segredo
JWT_EXPIRATION_SECONDS=604800

# Chave de servico do scraper para POST /api/imoveis/lote.
# Vazio = endpoint aberto (comportamento atual). Preencha nos dois lados para fechar.
SCRAPER_API_KEY=

SCRAPE_INTERVAL_SECONDS=604800
